# The Goodix 27c6:5201 fingerprint sensor enumerates as a CDC ACM modem.
# Keep ModemManager from probing it.
ACTION!="remove", SUBSYSTEM=="usb", ATTRS{idVendor}=="27c6", ATTRS{idProduct}=="5201", ENV{ID_MM_DEVICE_IGNORE}="1"
ACTION!="remove", SUBSYSTEM=="tty", ATTRS{idVendor}=="27c6", ATTRS{idProduct}=="5201", ENV{ID_MM_DEVICE_IGNORE}="1"
